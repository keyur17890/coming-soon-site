# ═══════════════════════════════════════════════════════════════
# VP INTERNATIONALS - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────────────
# Set to 'production' for live site, 'development' for local
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# MySQL/MariaDB connection settings
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_PORT=3306
DB_CHARSET=utf8mb4

# ─────────────────────────────────────────────────────────────────
# RECAPTCHA v3 CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ─────────────────────────────────────────────────────────────────
# SMTP EMAIL CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# Email sending settings (use your email provider's SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=info@vpinternationals.com
SMTP_FROM_NAME=VP Internationals
SMTP_ENCRYPTION=tls

# ─────────────────────────────────────────────────────────────────
# SITE CONFIGURATION
# ─────────────────────────────────────────────────────────────────
SITE_URL=https://vpinternationals.com
SITE_NAME=VP Internationals
SITE_TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────────────────────────
# SECURITY CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# CSRF token expiry time in seconds (1800 = 30 minutes)
CSRF_TOKEN_EXPIRY=1800

# Rate limiting settings
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# ─────────────────────────────────────────────────────────────────
# THIRD-PARTY INTEGRATIONS
# ─────────────────────────────────────────────────────────────────
# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Tawk.to Live Chat
TAWKTO_PROPERTY_ID=your_property_id
TAWKTO_WIDGET_ID=your_widget_id

# WhatsApp Business
WHATSAPP_NUMBER=+919876543210

# ─────────────────────────────────────────────────────────────────
# DEBUG & LOGGING
# ─────────────────────────────────────────────────────────────────
# Enable debug mode (set to false in production)
DEBUG_MODE=false

# Log file path (relative to root)
LOG_PATH=logs/error.log

# Slow query threshold in seconds
SLOW_QUERY_THRESHOLD=1.0
